{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "redirects": [
      {
        "source": "/score/:courtId",
        "destination": "https://africa-south1-__FIREBASE_PROJECT_ID__.cloudfunctions.net/getCourtScore/:courtId",
        "type": 307
      },
      {
        "source": "/revision/:courtId",
        "destination": "https://africa-south1-__FIREBASE_PROJECT_ID__.cloudfunctions.net/getCourtScoreRevision/:courtId",
        "type": 307
      },
      {
        "source": "/stats/:courtId",
        "destination": "https://africa-south1-__FIREBASE_PROJECT_ID__.cloudfunctions.net/getCourtStats/:courtId",
        "type": 307
      },
      {
        "source": "/momentum/:courtId",
        "destination": "https://africa-south1-__FIREBASE_PROJECT_ID__.cloudfunctions.net/getCourtMomentum/:courtId",
        "type": 307
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/app/js/script.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/css/style.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/court",
        "destination": "/app/index.html"
      },
      {
        "source": "/court/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/c",
        "destination": "/app/index.html"
      },
      {
        "source": "/c/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/play",
        "destination": "/app/index.html"
      },
      {
        "source": "/play/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/p",
        "destination": "/app/index.html"
      },
      {
        "source": "/p/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/overlay",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/overlay/**",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/broadcast",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/broadcast/**",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/app",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/nfc",
        "destination": "/nfc/index.html"
      },
      {
        "source": "/nfc/**",
        "destination": "/nfc/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
