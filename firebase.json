{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/court",
        "destination": "/app/index.html"
      },
      {
        "source": "/court/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/c",
        "destination": "/app/index.html"
      },
      {
        "source": "/c/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/a/**",
        "function": {
          "functionId": "getCourtScore",
          "region": "europe-west1"
        }
      },
      {
        "source": "/r/**",
        "function": {
          "functionId": "getCourtScoreRevision",
          "region": "europe-west1"
        }
      },
      {
        "source": "/s/**",
        "function": {
          "functionId": "getCourtStats",
          "region": "europe-west1"
        }
      },
      {
        "source": "/m/**",
        "function": {
          "functionId": "getCourtMomentum",
          "region": "europe-west1"
        }
      },
      {
        "source": "/b",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/b/**",
        "destination": "/app/overlay.html"
      },
      {
        "source": "/app",
        "destination": "/app/index.html"
      },
      {
        "source": "/app/**",
        "destination": "/app/index.html"
      },
      {
        "source": "/nfc",
        "destination": "/nfc/index.html"
      },
      {
        "source": "/nfc/**",
        "destination": "/nfc/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": []
    }
  ],
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
