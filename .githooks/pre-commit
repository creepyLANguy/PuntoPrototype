#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

staged_files="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|mjs)$' || true)"

if [ -z "$staged_files" ]; then
  exit 0
fi

echo "Formatting staged JavaScript files with Prettier..."

printf '%s\n' "$staged_files" | xargs ./functions/node_modules/.bin/prettier --write

printf '%s\n' "$staged_files" | xargs git add --

echo "Prettier formatting applied and staged."
