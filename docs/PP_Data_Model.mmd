---
config:
    theme: base
    themeVariables:
        primaryColor: '#E3F2FD'
        primaryBorderColor: '#1565C0'
        primaryTextColor: '#0D47A1'
        lineColor: '#455A64'
        secondaryColor: '#FFF3E0'
        tertiaryColor: '#E8F5E9'
---

%% The model is court-centric. ARCHIVE is a path segment in
%% courts/{courtId}/archive/{archiveId}/events, not a standalone document.

erDiagram
    COURT {
        string courtId PK
        string name
        string password
        string status
        timestamp createdAt
        integer scoreVersion
        string scoringMode
        object scoringOptions
        object teamNames
        object playerNames
    }

    SCORE_CURRENT {
        string courtId PK
        object teamA
        object teamB
        array completedSets
        boolean inTiebreak
        boolean matchComplete
        string lastEventId
        timestamp updatedAt
    }

    EVENT {
        string eventId PK
        string eventType
        string scoreVersion
        string createdBy
        timestamp createdAt
        string actorDeviceId
        string sourceCourtId
        string targetCourtId
        string registeringDeviceId
    }

    CHECKPOINT {
        string checkpointId PK
        string lastEventId
        timestamp lastCreatedAt
        object score
        object scoringOptions
        integer totalPoints
        integer setsCompleted
        timestamp updatedAt
    }

    ARCHIVE {
        string archiveId PK
        timestamp archivedAt
        string resetBy
    }

    ARCHIVED_EVENT {
        string eventId PK
        string eventType
        string scoreVersion
        string createdBy
        timestamp createdAt
        timestamp archivedAt
        string resetBy
    }

    DEVICE {
        string deviceId PK
        string courtId FK
    }

    COURT ||--|| SCORE_CURRENT : materializes
    COURT ||--o{ EVENT : owns
    COURT ||--o{ CHECKPOINT : accelerates
    COURT ||--o{ ARCHIVE : contains
    ARCHIVE ||--o{ ARCHIVED_EVENT : preserves
    COURT ||--o{ DEVICE : binds
