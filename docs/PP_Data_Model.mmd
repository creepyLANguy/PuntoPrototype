erDiagram
    COURT {
        string courtId PK
        string name
        string password
        string status
        timestamp createdAt
        integer scoreVersion
        string scoringMode
        object scoringOptions
        object teamNames
        object playerNames
        boolean beaconSidesSwapped
        object changeoverEvent
    }

    SCORE_CURRENT {
        string courtId PK
        object teamA
        object teamB
        array completedSets
        boolean inTiebreak
        boolean matchComplete
        string lastEventId
        string lastProcessedEventId
        timestamp lastProcessedCreatedAt
        timestamp updatedAt
    }

    EVENT {
        string eventId PK
        string eventType
        string scoreVersion
        string createdBy
        timestamp createdAt
        string actorDeviceId
        string sourceCourtId
        string targetCourtId
        string registeringDeviceId
        string sourceEventType
        boolean beaconSidesSwapped
    }

    CHECKPOINT {
        string checkpointId PK
        string lastEventId
        timestamp lastCreatedAt
        object score
        object scoringOptions
        integer totalPoints
        integer setsCompleted
        timestamp updatedAt
    }

    ARCHIVE {
        string archiveId PK
        timestamp archivedAt
        string resetBy
    }

    ARCHIVED_EVENT {
        string eventId PK
        string eventType
        string scoreVersion
        string createdBy
        timestamp createdAt
        timestamp archivedAt
        string resetBy
    }

    DEVICE {
        string deviceId PK
        string deviceSKU
        string courtId FK
    }

    COURT ||--|| SCORE_CURRENT : materializes
    COURT ||--o{ EVENT : owns
    COURT ||--o{ CHECKPOINT : accelerates
    COURT ||--o{ ARCHIVE : contains
    ARCHIVE ||--o{ ARCHIVED_EVENT : preserves
    COURT ||--o{ DEVICE : binds
