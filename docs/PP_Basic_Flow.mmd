flowchart LR
    classDef user fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef client fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef backend fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef data fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef device fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F

    subgraph PEOPLE["Users"]
        PLAYER["Player"]
        OPERATOR["Club / court operator"]
        HOST["Tournament host"]
        SPECTATOR["Spectator"]
        BROADCAST["Broadcast / integration consumer"]
    end

    subgraph CLIENTS["Current clients"]
        APP["Scoring web app"]
        MATCHPAGE["Match page /m/{matchId}"]
        TOURNAMENT["Tournament page /t/{id}"]
        HUB["Hub"]
        BEACON["Beacon"]
        PULSE["Pulse"]
        OVERLAY["Overlay"]
    end

    subgraph SERVER["Firebase"]
        POST["POST /postEvent"]
        MATCHCALL["manageMatch"]
        TOURCALL["manageTournament"]
        TRIGGER["onEventCreate"]
        SCORE["Scoring engine"]
        API["Public read API"]
    end

    subgraph DATA["Firestore"]
        COURT["Court configuration + activeMatchId"]
        MATCH["Match document"]
        EVENTS["Match event stream"]
        LIVE["Match current score"]
        TOURDATA["Tournament data"]
        VIEWS["Tournament read models"]
        DEVICES["Device bindings"]
    end

    PLAYER --> APP
    OPERATOR --> APP
    HOST --> TOURNAMENT
    OPERATOR --> HUB
    OPERATOR --> BEACON
    OPERATOR --> PULSE
    SPECTATOR --> MATCHPAGE
    SPECTATOR --> TOURNAMENT
    BROADCAST --> OVERLAY

    APP --> COURT
    APP --> MATCH
    APP --> EVENTS
    APP --> LIVE
    APP --> MATCHCALL
    TOURNAMENT --> TOURCALL
    TOURNAMENT --> VIEWS
    MATCHPAGE --> MATCH
    MATCHPAGE --> LIVE

    HUB --> POST
    BEACON --> POST
    PULSE --> POST
    POST --> DEVICES
    POST --> COURT
    POST --> EVENTS

    EVENTS --> TRIGGER
    TRIGGER --> SCORE
    SCORE --> LIVE
    SCORE --> MATCH
    TOURCALL --> TOURDATA
    TOURCALL --> MATCH
    TOURCALL --> VIEWS

    OVERLAY --> API
    API --> MATCH
    API --> LIVE
    API --> EVENTS

    class PLAYER,OPERATOR,HOST,SPECTATOR,BROADCAST user
    class APP,MATCHPAGE,TOURNAMENT,OVERLAY client
    class HUB,BEACON,PULSE device
    class POST,MATCHCALL,TOURCALL,TRIGGER,SCORE,API backend
    class COURT,MATCH,EVENTS,LIVE,TOURDATA,VIEWS,DEVICES data
