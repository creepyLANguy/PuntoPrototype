flowchart LR
    classDef user fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef client fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef backend fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef data fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef device fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F

    subgraph PEOPLE["Users"]
        PLAYER["Player"]
        OPERATOR["Club / court operator"]
        SPECTATOR["Spectator"]
        BROADCAST["Broadcast / integration consumer"]
    end

    subgraph CLIENTS["Current clients"]
        APP["Web app"]
        HUB["Hub"]
        BEACON["Beacon"]
        PULSE["Pulse"]
        OVERLAY["Overlay"]
    end

    subgraph SERVER["Firebase"]
        POST["POST /postEvent"]
        TRIGGER["onEventCreate"]
        SCORE["Scoring engine"]
        CALLABLE["Callable functions"]
        API["Public read API"]
    end

    subgraph DATA["Firestore"]
        COURT["Court configuration"]
        EVENTS["Event stream"]
        LIVE["Current score"]
        CHECK["Checkpoints"]
        ARCHIVE["Reset archives"]
        DEVICES["Device bindings"]
    end

    PLAYER --> APP
    OPERATOR --> APP
    OPERATOR --> HUB
    OPERATOR --> BEACON
    OPERATOR --> PULSE
    SPECTATOR --> OVERLAY
    BROADCAST --> OVERLAY

    APP --> COURT
    APP --> EVENTS
    APP --> LIVE
    APP --> CALLABLE
    APP --> DEVICES

    HUB --> POST
    BEACON --> POST
    PULSE --> POST
    POST --> DEVICES
    POST --> EVENTS

    EVENTS --> TRIGGER
    TRIGGER --> SCORE
    SCORE --> LIVE
    SCORE --> CHECK

    CALLABLE --> COURT
    CALLABLE --> EVENTS
    CALLABLE --> LIVE
    CALLABLE --> CHECK
    CALLABLE --> ARCHIVE

    OVERLAY --> API
    API --> LIVE
    API --> EVENTS

    class PLAYER,OPERATOR,SPECTATOR,BROADCAST user
    class APP,OVERLAY client
    class HUB,BEACON,PULSE device
    class POST,TRIGGER,SCORE,CALLABLE,API backend
    class COURT,EVENTS,LIVE,CHECK,ARCHIVE,DEVICES data
