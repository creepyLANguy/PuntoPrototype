flowchart LR
    classDef client fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef firebase fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef data fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef device fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F
    classDef delivery fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238
    classDef target fill:#FAFAFA,stroke:#777777,stroke-width:1px,stroke-dasharray:5 5,color:#444444

    subgraph CLIENTS["Current client surfaces"]
        subgraph WEBAPP["Scoring web app - native ES modules"]
            WEB["main.js"]
            COURTUI["court/ + scoring/<br/>court session follows active match"]
            MATCHUI["matchPage.js + match/<br/>/m/{matchId}"]
            TOURUI["tournamentPage.js + tournament/<br/>/t, /t/new, /t/{id}"]
            ADMIN["admin/<br/>courts, matches, tournaments, devices, clubs"]
            FB["firebase/<br/>repositories + callables"]
        end
        OVERLAY["OBS overlay<br/>/overlay/{courtId}<br/>/overlay/match/{matchId}"]
        NFC["NFC utility"]
        LAB["Device Lab"]
    end

    subgraph FIRMWARE["Current firmware repository"]
        HUB["Hub"]
        BEACON["Beacon"]
        PULSE["Pulse"]
    end

    subgraph FIREBASE["Firebase runtime"]
        HOST["Firebase Hosting"]
        INGEST["postEvent"]
        MATCHCALL["manageMatch"]
        TOURCALL["manageTournament"]
        OTHERCALL["resetCourt / changeoverCourt / clubs"]
        TRIGGER["onEventCreate"]
        CLUBTRIGGER["onCourtDeleted / onDeviceDeleted"]
        SCORE["Scoring + replay services"]
        PUBLIC["Public read functions"]
    end

    subgraph DATA["Firestore"]
        COURTS["courts/{courtId}<br/>physical court + activeMatchId"]
        MATCHES["matches/{matchId}<br/>durable match identity"]
        EVENTS["matches/{matchId}/events/{eventId}<br/>authoritative scoring history"]
        LIVE["matches/{matchId}/score/current<br/>derived live score"]
        CHECK["match checkpoints + archive"]
        TOURS["tournaments/{tournamentId}<br/>participants, teams, rounds, fixtures, audits"]
        VIEWS["tournamentViews / tournamentPrivateViews / tournamentDirectory"]
        SECRETS["tournamentSecrets<br/>hashed host/access keys"]
        DEVICES["devices/{deviceId}<br/>device identity + court binding + club"]
        CLUBS["clubs/{clubId}<br/>club + courts/devices"]
    end

    subgraph DELIVERY["Current delivery"]
        REPO["GitHub repositories"]
        TESTS["Automated tests / deploy gate"]
        STAGING["non-main -> staging"]
        PROD["main -> production"]
    end

    subgraph TARGETS["Production-hardening targets"]
        AUTH["Cryptographic device authentication<br/>freshness / replay / idempotency"]
        RBAC["Full account/RBAC model"]
        MFG["Manufacturing / provisioning system"]
    end

    HOST --> WEB
    HOST --> MATCHUI
    HOST --> TOURUI
    HOST --> OVERLAY
    HOST --> NFC
    ADMIN --> LAB

    WEB --> COURTUI
    COURTUI --> FB
    MATCHUI --> FB
    TOURUI --> FB
    ADMIN --> FB

    FB --> COURTS
    FB --> MATCHES
    FB --> EVENTS
    FB --> LIVE
    FB --> DEVICES
    FB --> CLUBS
    FB --> MATCHCALL
    FB --> TOURCALL
    FB --> OTHERCALL

    HUB --> INGEST
    BEACON --> INGEST
    PULSE --> INGEST
    INGEST --> DEVICES
    INGEST --> COURTS
    INGEST --> EVENTS
    EVENTS --> TRIGGER
    TRIGGER --> SCORE
    SCORE --> LIVE
    SCORE --> CHECK
    SCORE --> MATCHES

    MATCHCALL --> MATCHES
    MATCHCALL --> COURTS
    MATCHCALL --> EVENTS
    TOURCALL --> TOURS
    TOURCALL --> MATCHES
    TOURCALL --> VIEWS
    TOURCALL --> SECRETS
    OTHERCALL --> COURTS
    OTHERCALL --> CLUBS
    COURTS --> CLUBTRIGGER
    DEVICES --> CLUBTRIGGER
    CLUBTRIGGER --> CLUBS

    OVERLAY --> PUBLIC
    PUBLIC --> MATCHES
    PUBLIC --> LIVE
    PUBLIC --> EVENTS

    REPO --> TESTS
    TESTS --> STAGING
    REPO --> PROD

    INGEST -. "target" .-> AUTH
    TOURCALL -. "target" .-> RBAC
    MATCHCALL -. "target" .-> RBAC
    HUB -. "outside repo boundary" .-> MFG
    BEACON -. "outside repo boundary" .-> MFG
    PULSE -. "outside repo boundary" .-> MFG

    class WEB,COURTUI,MATCHUI,TOURUI,ADMIN,FB,OVERLAY,NFC,LAB client
    class HUB,BEACON,PULSE device
    class HOST,INGEST,MATCHCALL,TOURCALL,OTHERCALL,TRIGGER,CLUBTRIGGER,SCORE,PUBLIC firebase
    class COURTS,MATCHES,EVENTS,LIVE,CHECK,TOURS,VIEWS,SECRETS,DEVICES,CLUBS data
    class REPO,TESTS,STAGING,PROD delivery
    class AUTH,RBAC,MFG target
