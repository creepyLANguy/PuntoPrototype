flowchart LR
    classDef client fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef firebase fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C
    classDef data fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20
    classDef device fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F
    classDef delivery fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238
    classDef future fill:#FAFAFA,stroke:#777777,stroke-width:1px,stroke-dasharray:5 5,color:#444444

    subgraph CLIENTS["Current client surfaces"]
        subgraph WEBAPP["Web app - native ES modules (app/js)"]
            WEB["main.js<br/>composition root"]
            WROUTE["routing/<br/>routes, history, views"]
            WSTATE["state/<br/>session, app, navigation, theme"]
            WFEAT["scoring/ court/ details/ sharing/<br/>qr/ nfc/ admin/ teams/ shell/"]
            WUI["ui/<br/>DOM, modals, toasts, theme"]
            WFB["firebase/<br/>client, repositories, callables"]
        end
        ADMIN["Admin routes<br/>/admin and /app/admin"]
        OVERLAY["OBS / public overlay<br/>app/overlay.html (built from app/overlay/)"]
        NFC["NFC utility<br/>nfc/index.html"]
        LAB["Device Lab / harness<br/>admin-gated"]
    end

    subgraph FIRMWARE["Current firmware repository"]
        HUB["Hub<br/>NFC + control"]
        BEACON["Beacon<br/>distance trigger"]
        PULSE["Pulse<br/>button remote"]
    end

    subgraph FIREBASE["Firebase runtime"]
        HOST["Firebase Hosting"]
        INGEST["postEvent<br/>HTTP Cloud Function"]
        CALLABLE["Callable functions<br/>resetCourt / changeoverCourt / updateScoringOptions / getDetailedScore"]
        TRIGGER["onEventCreate"]
        SCORE["Scoring + replay services"]
        PUBLIC["Public read functions"]
    end

    subgraph DATA["Firestore"]
        COURT["courts/{courtId}<br/>configuration + active match state"]
        EVENTS["courts/{courtId}/events/{eventId}<br/>authoritative active event history"]
        LIVE["courts/{courtId}/score/current<br/>derived live score"]
        CHECK["scoreCheckpoints<br/>replay accelerators"]
        ARCHIVE["archive/{archiveId}/events<br/>reset archives"]
        DEVICES["devices/{deviceId}<br/>device identity + court binding"]
    end

    subgraph DELIVERY["Current delivery"]
        REPO["GitHub repositories"]
        TESTS["Automated tests / deploy gate"]
        STAGING["non-main -> staging"]
        PROD["main -> production"]
    end

    subgraph NOT_IMPLEMENTED["Not yet implemented as production controls"]
        AUTH["Cryptographic device authentication<br/>freshness / replay / idempotency"]
        RBAC["Explicit callable request.auth RBAC"]
        MATCH["First-class match/tournament model"]
        MFG["Manufacturing / provisioning system"]
    end

    HOST -- "generated app/index.html" --> WEB
    WEB --> WROUTE
    WEB --> WFEAT
    WROUTE --> WFEAT
    WFEAT --> WSTATE
    WFEAT --> WUI
    WFEAT --> WFB
    HOST --> ADMIN
    HOST --> OVERLAY
    HOST --> NFC
    ADMIN --> LAB

    WFB --> COURT
    WFB --> EVENTS
    WFB --> LIVE
    WFB --> CALLABLE
    WFB --> DEVICES

    HUB --> INGEST
    BEACON --> INGEST
    PULSE --> INGEST
    INGEST --> DEVICES
    INGEST --> EVENTS
    EVENTS --> TRIGGER
    TRIGGER --> SCORE
    SCORE --> LIVE
    SCORE --> CHECK

    CALLABLE --> COURT
    CALLABLE --> EVENTS
    CALLABLE --> LIVE
    CALLABLE --> CHECK
    CALLABLE --> ARCHIVE

    OVERLAY --> PUBLIC
    PUBLIC --> LIVE
    PUBLIC --> EVENTS

    REPO --> TESTS
    TESTS --> STAGING
    REPO --> PROD

    INGEST -. "production target" .-> AUTH
    CALLABLE -. "production target" .-> RBAC
    COURT -. "future architecture" .-> MATCH
    HUB -. "business process outside repo" .-> MFG
    BEACON -. "business process outside repo" .-> MFG
    PULSE -. "business process outside repo" .-> MFG

    class WEB,WROUTE,WSTATE,WFEAT,WUI,WFB,ADMIN,OVERLAY,NFC,LAB client
    class HUB,BEACON,PULSE device
    class HOST,INGEST,CALLABLE,TRIGGER,SCORE,PUBLIC firebase
    class COURT,EVENTS,LIVE,CHECK,ARCHIVE,DEVICES data
    class REPO,TESTS,STAGING,PROD delivery
    class AUTH,RBAC,MATCH,MFG future
