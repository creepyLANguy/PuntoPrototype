flowchart LR

    classDef current fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1,font-weight:bold;
    classDef firebase fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C,font-weight:bold;
    classDef data fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20,font-weight:bold;
    classDef delivery fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238,font-weight:bold;
    classDef product fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F,font-weight:bold;
    classDef future fill:#FAFAFA,stroke:#9E9E9E,stroke-width:1px,stroke-dasharray:5 5,color:#616161;

    subgraph CLIENTS["Current client surfaces"]
        WebApp["Padel Push™ web app<br/>app/index.html<br/>app/js/script.js"]
        Overlay["OBS / broadcast overlay<br/>app/overlay.html"]
        NFC["NFC utility<br/>nfc/index.html"]
        DeviceClient["External device clients<br/>POST /postEvent<br/>firmware is not in this repository"]
    end

    subgraph FIREBASE["Firebase runtime"]
        Hosting["Firebase Hosting<br/>static files + rewrites"]

        Ingestion["postEvent<br/>HTTP Cloud Function<br/>africa-south1<br/>deviceId/binding identity only"]

        Callable["Callable Cloud Functions<br/>africa-south1"]
        Reset["resetCourt"]
        Options["updateScoringOptions"]
        Details["getDetailedScore"]

        PublicAPI["Public HTTP read functions<br/>africa-south1<br/>getCourtScore<br/>getCourtScoreRevision<br/>getCourtStats<br/>getCourtMomentum"]

        Trigger["Firestore trigger<br/>onEventCreate<br/>africa-south1"]
        Scoring["Scoring engine<br/>scoringEngine.js"]
    end

    subgraph FIRESTORE["Cloud Firestore"]
        Court["courts/{courtId}<br/>configuration + active match state"]
        Events[("courts/{courtId}/events/{eventId}<br/>append-only events")]
        Score[("courts/{courtId}/score/current<br/>materialized live score")]
        Checkpoints[("courts/{courtId}/scoreCheckpoints/{id}<br/>replay accelerators")]
        Archives[("courts/{courtId}/archive/{archiveId}/events<br/>reset archives")]
        Devices[("devices/{deviceId}<br/>device binding")]
    end

    subgraph PRODUCT["Device concepts represented by the current product site"]
        Pulse["Pulse"]
        Beacon["Beacon"]
        Hub["Hub"]
    end

    subgraph DELIVERY["Current delivery"]
        Repo["Git repository"]
        Tests["Functions Jest + Node integration tests"]
        Staging["Non-main branch deployment<br/>staging project / preview"]
        Production["main deployment<br/>production project"]
        Rules["firestore.rules + firestore.indexes.json<br/>tracked in repo; not deployed by current CI workflow"]
    end

    subgraph FUTURE["Not implemented in current repository"]
        HardwareFW["Physical-device firmware source"]
        Hmac["HMAC/device-secret auth<br/>freshness + replay protection"]
        MatchModel["First-class match/tournament model"]
        Analytics["Commercial analytics / billing"]
    end

    Hosting --> WebApp
