---
config:
    theme: base
---

flowchart LR

        classDef hardware fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20,font-weight:bold;
        classDef firebase fill:#FFF3E0,stroke:#E65100,stroke-width:2px,color:#BF360C,font-weight:bold;
        classDef web fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1,font-weight:bold;
        classDef broadcast fill:#E0F2F1,stroke:#00695C,stroke-width:2px,color:#004D40,font-weight:bold;
        classDef user fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C,font-weight:bold;
        classDef delivery fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238,font-weight:bold;
        classDef operations fill:#FFFDE7,stroke:#FBC02D,stroke-width:2px,color:#F57F17,font-weight:bold;
        classDef primary fill:#FFF8E1,stroke:#C62828,stroke-width:4px,color:#7F0000,font-weight:bold;
        classDef legendHardware fill:#E8F5E9,stroke:#2E7D32,color:#1B5E20;
        classDef legendFirebase fill:#FFF3E0,stroke:#E65100,color:#BF360C;
        classDef legendWeb fill:#E3F2FD,stroke:#1565C0,color:#0D47A1;
        classDef legendFuture fill:#FAFAFA,stroke:#9E9E9E,stroke-dasharray:5 5,color:#616161;
        classDef future fill:#FAFAFA,stroke:#9E9E9E,stroke-width:1px,stroke-dasharray:5 5,color:#616161;

    %% =========================================================
    %% PADEL PUSH - TECHNICAL ARCHITECTURE
    %% =========================================================

    subgraph COURT["Court Hardware"]
        
        Beacon["Beacon<br/>ESP32 firmware<br/>beacon.ino"]
        Pulse["Pulse<br/>ESP32 firmware<br/>pulse.ino"]
        Hub["Hub<br/>ESP32 firmware + PN532 NFC<br/>hub.ino"]
        Portal["Portal<br/>portal.ino<br/>painlessMesh TODO"]

        WiFi["Court Wi-Fi"]

        Beacon --> WiFi
        Pulse --> WiFi
        Hub --> WiFi

        NFCReader["NFC reader"]
        NFCReader --> Hub
    end


    subgraph FIREBASE["Firebase Platform"]

        Hosting["Firebase Hosting<br/>Static web application"]

        HTTP["HTTP Cloud Function<br/>postEvent<br/>africa-south1<br/>deviceId auth; HMAC hardening planned"]

        Callable["Callable Cloud Functions<br/>africa-south1"]
        Reset["resetCourt"]
        Options["updateScoringOptions"]
        Details["getDetailedScore"]
        PublicAPI["Public HTTP read functions<br/>europe-west1<br/>/a /r /s /m"]

        Callable --> Reset
        Callable --> Options
        Callable --> Details

        Firestore[("Cloud Firestore")]

        Courts["courts/{courtId}<br/>Court configuration"]
        Events[("courts/{courtId}/events<br/>Immutable match events")]
        CurrentScore[("courts/{courtId}/score/current<br/>Current live score")]
        Checkpoints[("courts/{courtId}/scoreCheckpoints<br/>Replay checkpoints")]
        Devices["devices/{deviceId}<br/>Device registration"]
        Archive[("courts/{courtId}/archive/{resetId}/events<br/>Reset archives")]

        Firestore --- Courts
        Firestore --- Events
        Firestore --- CurrentScore
        Firestore --- Checkpoints
        Firestore --- Devices
        Firestore --- Archive

        Trigger["Firestore trigger<br/>onEventCreate"]

        Scoring["Scoring engine<br/>scoringEngine.js"]

        HTTP --> Events
        Events --> Trigger
        Trigger --> Scoring
        Scoring --> CurrentScore
        Scoring --> Checkpoints

        Reset --> Events
        Reset --> CurrentScore
        Reset --> Archive
        Options --> Events
        Options --> CurrentScore
        Details --> Events
        Details --> Events
        PublicAPI --> CurrentScore
        PublicAPI --> Events
    end


    subgraph OVERLAY["Broadcast Surface"]
        Overlay["OBS overlay<br/>app/overlay.html"]
        Overlay -->|"GET /r/{courtId}, /a/{courtId}<br/>GET /s/{courtId}, /m/{courtId}"| PublicAPI
    end

    subgraph WEB["Web Application"]

        WebApp["Padel Push Web App<br/>app/index.html<br/>app/js/script.js"]

        Scoreboard["Live scoreboard"]
        Play["Play / scoring controls"]
        Spectate["Spectator view"]
        Admin["Admin dashboard"]
        CourtSetup["Court creation and setup"]
        DeviceAdmin["Device assignment and management"]
        QR["QR code generation"]
        NFCWeb["Browser NFC interaction"]

        WebApp --> Scoreboard
        WebApp --> Play
        WebApp --> Spectate
        WebApp --> Admin
        WebApp --> CourtSetup
        WebApp --> DeviceAdmin
        WebApp --> QR
        WebApp --> NFCWeb
    end


    subgraph USERS["Users"]
        Player["Players"]
        Spectator["Spectators"]
        ClubOperator["Club operators"]
        Administrator["System administrators"]
    end


    subgraph DELIVERY["Software Delivery"]

        Repository["Source repository<br/>Firmware • Web • Functions"]
        Tests["Automated tests<br/>functions/*.test.js"]
        Deploy["Firebase deployment"]
        Staging["Staging Firebase environment"]
        Production["Production Firebase environment"]

        Repository --> Tests
        Tests --> Deploy
        Deploy --> Staging
        Deploy --> Production
    end


    subgraph OPERATIONS["Operations"]

        Monitoring["Monitoring and logs"]
        Diagnostics["Device diagnostics"]
        Support["Technical support"]
        Provisioning["Wi-Fi and device provisioning"]

        Monitoring --> Support
        Diagnostics --> Support
        Provisioning --> Diagnostics
    end


    %% =========================================================
    %% DEVICE RUNTIME FLOWS
    %% =========================================================

    Beacon -->|"HTTPS POST event"| HTTP
    Pulse -->|"HTTPS POST event"| HTTP
    Hub -->|"HTTPS POST event"| HTTP

    Hub -. "NFC configuration and tag reading" .-> NFCReader
    Hub -->|"REGISTER via postEvent"| HTTP

    Portal -. "Future court gateway role" .-> WiFi


    %% =========================================================
    %% WEB RUNTIME FLOWS
    %% =========================================================

    Hosting --> WebApp

    WebApp -->|"onSnapshot listener"| CurrentScore
    CurrentScore -->|"Live score updates"| WebApp

    WebApp -->|"Add scoring / operational events"| Events
    WebApp -->|"Admin operations"| Callable
    WebApp -->|"Court and device reads/writes"| Firestore

    WebApp -. "QR links and court access" .-> QR
    WebApp -. "Supported browser NFC interaction" .-> NFCWeb


    %% =========================================================
    %% USER FLOWS
    %% =========================================================

    Player --> Play
    Player --> NFCWeb
    Player --> QR

    Spectator --> Spectate
    ClubOperator --> Admin
    Administrator --> Admin


    %% =========================================================
    %% DEPLOYMENT FLOWS
    %% =========================================================

    Staging -. "Validated release" .-> Production
    Production -. "Hosts" .-> Hosting
    Production -. "Deploys Firestore rules/indexes" .-> Firestore


    %% =========================================================
    %% OPERATIONS FLOWS
    %% =========================================================

    Production -. "Logs and runtime health" .-> Monitoring
    Devices -. "Status and diagnostics" .-> Diagnostics
    Provisioning -. "Configures" .-> Beacon
    Provisioning -. "Configures" .-> Pulse
    Provisioning -. "Configures" .-> Hub


    %% =========================================================
    %% OPTIONAL / FUTURE INTEGRATIONS
    %% =========================================================

    subgraph FUTURE["Optional / Future Integrations"]
        Streaming["OBS / vMix / streaming platform"]
        Analytics["Club analytics"]
        Billing["Billing and subscriptions"]
    end

    subgraph LEGEND["Diagram key"]
        LegendHardware["Implemented hardware"]
        LegendFirebase["Implemented platform"]
        LegendWeb["Implemented web surface"]
        LegendFuture["Future or optional"]
    end

    CurrentScore -. "Future reporting" .-> Analytics
    Admin -. "Future commercial controls" .-> Billing

    class Beacon,Pulse,Hub,WiFi,NFCReader hardware
    class Hosting,HTTP,Callable,Reset,Options,Details,PublicAPI,Firestore,Courts,Events,CurrentScore,Checkpoints,Archive,Devices,Trigger,Scoring firebase
    class WebApp,Scoreboard,Play,Spectate,Admin,CourtSetup,DeviceAdmin,QR,NFCWeb web
    class Player,Spectator,ClubOperator,Administrator user
    class Repository,Tests,Deploy,Staging,Production delivery
    class Monitoring,Diagnostics,Support,Provisioning operations
    class Portal,Streaming,Analytics,Billing future
    class HTTP,Events,Trigger,Scoring,CurrentScore primary
    class LegendHardware legendHardware;
    class LegendFirebase legendFirebase;
    class LegendWeb legendWeb;
    class LegendFuture legendFuture;

    style COURT fill:#F1F8E9,stroke:#33691E,stroke-width:2px;
