---
config:
    theme: base
---

flowchart LR

    classDef current fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1,font-weight:bold;
    classDef product fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F;
    classDef delivery fill:#ECEFF1,stroke:#455A64,stroke-width:2px,color:#263238;
    classDef business fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C;
    classDef future fill:#FAFAFA,stroke:#9E9E9E,stroke-width:1px,stroke-dasharray:5 5,color:#616161;

    Founder["Founder / Product Owner"]

    subgraph CURRENT["Current repo-backed product"]
        Landing["Marketing site<br/>index.html"]
        WebApp["Scoring web app<br/>Play • Spectate • Scoreboard"]
        Admin["Admin surfaces<br/>Courts • Devices"]
        Overlay["OBS / broadcast overlay"]
        NFC["NFC utility"]
        Backend["Firebase Functions<br/>scoring + replay + public API"]
        Firestore["Firestore<br/>courts • events • score • checkpoints • archives"]
        DeviceAPI["Device ingestion API<br/>/postEvent"]
        Tests["Automated test suite"]
        Environments["Staging + production deployment"]
    end

    subgraph DEVICES["Current product concepts shown on the marketing site"]
        Pulse["Pulse<br/>portable scoring control"]
        Beacon["Beacon<br/>hands-free scoring concept"]
        Hub["Hub<br/>smart court integration concept"]
    end

    subgraph BUSINESS["Business / operational surfaces represented in the repo"]
        ProductDesign["Product and UX development"]
        Documentation["Technical documentation"]
        Support["Club / operator support"]
        Marketing["Marketing and brand"]
        Partnerships["Club pilots and partnerships"]
    end

    subgraph OUTSIDE["Outside current repo / future implementation"]
        Firmware["Physical-device firmware source"]
        Manufacturing["Manufacturing + provisioning system"]
        MatchModel["First-class match / tournament model"]
        Billing["Billing / subscriptions"]
        Analytics["Commercial analytics"]
    end

    Founder --> ProductDesign
    Founder --> Marketing
    Founder --> Partnerships

    Landing --> Pulse
    Landing --> Beacon
    Landing --> Hub

    WebApp --> Firestore
    WebApp --> Backend
    Admin --> Firestore
    Overlay --> Backend
    NFC --> WebApp
    DeviceAPI --> Backend
    Backend --> Firestore

    Tests --> Backend
    Tests --> WebApp
    Environments --> Backend
    Environments --> WebApp

    ProductDesign --> WebApp
    Documentation --> Backend
    Support --> Admin
    Marketing --> Landing
    Partnerships --> Landing

    Pulse -. "implementation outside repo" .-> Firmware
    Beacon -. "implementation outside repo" .-> Firmware
    Hub -. "implementation outside repo" .-> Firmware
    Firmware -. "future" .-> Manufacturing
    Firestore -. "future architecture" .-> MatchModel
    Firestore -. "future" .-> Billing
    Firestore -. "future" .-> Analytics

    class Landing,WebApp,Admin,Overlay,NFC,Backend,Firestore,DeviceAPI current
    class Pulse,Beacon,Hub product
    class Tests,Environments delivery
    class ProductDesign,Documentation,Support,Marketing,Partnerships business
    class Firmware,Manufacturing,MatchModel,Billing,Analytics future

    style CURRENT fill:#E8EAF6,stroke:#1A237E,stroke-width:2px;
    style DEVICES fill:#FCE4EC,stroke:#AD1457,stroke-width:2px;
    style BUSINESS fill:#F3E5F5,stroke:#4A148C,stroke-width:2px;
    style OUTSIDE fill:#FAFAFA,stroke:#9E9E9E,stroke-dasharray:5 5;
