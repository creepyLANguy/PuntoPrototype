flowchart TB
    classDef role fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148C
    classDef process fill:#E8EAF6,stroke:#1A237E,stroke-width:2px,color:#1A237E
    classDef system fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1
    classDef device fill:#FCE4EC,stroke:#C2185B,stroke-width:2px,color:#880E4F
    classDef external fill:#FAFAFA,stroke:#777777,stroke-width:1px,stroke-dasharray:5 5,color:#444444

    subgraph ROLES["Organisational roles"]
        BO["Business Owner / Managing Director"]
        PO["Product Owner"]
        ENG["Platform Engineering"]
        HW["Hardware / Firmware Engineering"]
        QA["Quality / Release"]
        OPS["Operations / Supply Chain"]
        CS["Customer / Club Operations"]
        COM["Sales / Partnerships"]
        FLC["Finance / Legal / Compliance"]
    end

    subgraph OPERATIONS["Core business processes"]
        P1["BP-01 Product & change control"]
        P2["BP-02 Software release"]
        P3["BP-03 Court setup"]
        P4["BP-04 Live scoring operation"]
        P5["BP-05 Device registration / assignment"]
        P6["BP-07 Beacon court changeover"]
        P7["BP-08 Device validation"]
        P8["BP-09 Support & incident handling"]
        P9["BP-10 Physical production / provisioning"]
    end

    subgraph PLATFORM["Current platform"]
        APP["Padel Push web app"]
        ADMIN["Admin portal"]
        LAB["Device Lab / harness"]
        INGEST["POST /postEvent"]
        SCORE["Scoring + replay engine"]
        DATA["Firestore court/event state"]
        API["Public score / revision / stats / momentum API"]
        DEPLOY["Staging / production deployment"]
    end

    subgraph DEVICES["Current device families"]
        HUB["Hub<br/>NFC + operational control"]
        BEACON["Beacon<br/>distance-triggered scoring"]
        PULSE["Pulse<br/>button scoring"]
    end

    subgraph EXTERNAL["Outside repository boundary"]
        MFG["Manufacturing / provisioning system"]
        CLUB["Club / venue"]
        BROADCAST["OBS / integration consumer"]
    end

    BO --> P1
    PO --> P1
    P1 --> P2
    P1 --> P3
    P1 --> P5
    P1 --> P9

    P2 --> DEPLOY
    P2 --> APP
    P2 --> ADMIN
    P2 --> LAB

    CS --> P3
    P3 --> APP
    P3 --> DATA

    CLUB --> P4
    P4 --> APP
    P4 --> HUB
    P4 --> BEACON
    P4 --> PULSE

    HUB --> INGEST
    BEACON --> INGEST
    PULSE --> INGEST
    INGEST --> SCORE
    SCORE --> DATA
    DATA --> API
    API --> BROADCAST

    P4 --> P6
    P6 --> DATA
    P6 --> BEACON

    OPS --> P5
    P5 --> ADMIN
    P5 --> HUB
    P5 --> BEACON
    P5 --> PULSE

    QA --> P7
    P7 --> LAB
    LAB --> HUB
    LAB --> BEACON
    LAB --> PULSE

    CS --> P8
    P8 --> DATA
    P8 --> LAB
    P8 --> ENG
    P8 --> HW

    OPS --> P9
    HW --> P9
    MFG --> P9

    BO --> FLC
    COM --> CS
    COM --> BO

    class BO,PO,ENG,HW,QA,OPS,CS,COM,FLC role
    class P1,P2,P3,P4,P5,P6,P7,P8,P9 process
    class APP,ADMIN,LAB,INGEST,SCORE,DATA,API,DEPLOY system
    class HUB,BEACON,PULSE device
    class MFG,CLUB,BROADCAST external
